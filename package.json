{
  "name": "opencode-telos",
  "version": "1.1.11",
  "description": "OpenCode Telos - Spec-Driven Development plugin with Knowledge Graph enforcement",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "marketplace.json"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sdd",
    "spec-driven-development",
    "knowledge-graph",
    "code-generation",
    "drift-detection",
    "enforcement",
    "ai-slop-prevention"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server-entry.d.ts",
      "default": "./dist/server-entry.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "prepublishOnly": "npm run build && node scripts/check-import-isolated.cjs"
  },
  "dependencies": {
    "js-yaml": "4.3.2",
    "tree-sitter": "0.25.1",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0"
  },
  "overrides": {
    "tree-sitter-java": {
      "tree-sitter": "0.25.1"
    },
    "tree-sitter-ruby": {
      "tree-sitter": "0.25.1"
    },
    "tree-sitter-rust": {
      "tree-sitter": "0.25.1"
    }
  },
  "trustedDependencies": [
    "tree-sitter-go",
    "tree-sitter-java",
    "tree-sitter-python",
    "tree-sitter-ruby",
    "tree-sitter-rust"
  ]
}
