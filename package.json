{
  "name": "@oktis-works/telos-sdd-graph",
  "version": "3.2.0",
  "description": "OpenCode Telos - Spec-Driven Development plugin with Knowledge Graph enforcement",
  "homepage": "https://github.com/JudahAragao/opencode-telos#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JudahAragao/opencode-telos.git"
  },
  "bugs": {
    "url": "https://github.com/JudahAragao/opencode-telos/issues"
  },
  "license": "MIT",
  "author": "Telos Team",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/sync-version.cjs && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:sync": "node scripts/sync-version.cjs",
    "prepack": "npm run build",
    "release": "npm publish --access public"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.32",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sdd",
    "spec-driven-development",
    "knowledge-graph",
    "drift-detection",
    "enforcement",
    "telos"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}